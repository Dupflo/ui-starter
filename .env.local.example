# --- Supabase ---
# Créer un projet sur supabase.com, puis copier ces 3 valeurs (Project Settings > API).
# La service role key est un SECRET : ne jamais la committer ni la coller ailleurs que dans .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (abonnements) ---
# Clé secrète (sk_test_… en dev, sk_live_… en prod). Console : dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…). Endpoint POST /api/webhooks/stripe côté Stripe.
STRIPE_WEBHOOK_SECRET=
